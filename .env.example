# Nebius Token Factory Configuration
TOKEN_FACTORY_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_TOKEN_FACTORY_KEY=your_nebius_token_factory_api_key_here

# Models on Nebius Token Factory
NEMOTRON_NANO_MODEL=nvidia/Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1
COSMOS_REASONER_MODEL=nvidia/Cosmos3-Super-Reasoner

# Tavily API Configuration (Real-World Physical Constants)
TAVILY_API_KEY=your_tavily_api_key_here

# Nebius Physical AI Workbench & Object Storage
NPA_EXECUTION_MODE=auto  # "nebius" | "local" | "auto"
S3_BUCKET_URI=s3://physics-audit
DATA_DIR=./data

